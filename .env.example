# Google Cloud Project Configuration
ProjectID=your-project-id
ProcessorID=your-docai-processor-id
Location=us

# Path to service account credentials JSON file
CREDENTIALS_PATH=/path/to/your/service-account-key.json

# Required: OpenAI API key for semantic planning and panel translation.
# Also used for optional glossary research, image-aware cleanup and tagging.
OPENAI_API_KEY=your-openai-api-key

# Optional: override the default cleanup model (gpt-5-mini)
# OPENAI_MODEL=gpt-5-mini

# Optional: semantic page-planning model (default gpt-5.5)
# LAYOUT_MODEL=gpt-5.5

# Optional: glossary web-search model (defaults to OPENAI_MODEL, then gpt-5-mini)
# GLOSSARY_MODEL=gpt-5-mini
# Web research and image cleanup require available OpenAI API credits.

# Offline experiment tools only; the current pipeline skips the extra checker.
# INSTRUCTION_CHECK_MODEL=gpt-5-mini
# Optional local OCR for offline benchmark tools.
# YOMITOKU_PYTHON=/absolute/path/to/.venv-quality/bin/python
# YOMITOKU_DEVICE=cpu
